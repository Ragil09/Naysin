# Contoh saja. Buat .env lokal dan JANGAN commit nilainya.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/naysin2?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/naysin2?schema=public"
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"

# Opsional: Asisten Gemini di halaman web
ASSISTANT_PROVIDER="gemini"
GEMINI_MODEL="SET_TO_AN_AVAILABLE_GEMINI_MODEL_ID"
GEMINI_API_KEY=""
PUBLIC_GEMINI_ENABLED="false"

# Opsional: Click-to-Chat ke WhatsApp mitra, contoh harus diganti
NAYSIN_WHATSAPP_NUMBER=""